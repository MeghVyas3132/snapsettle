# Copy to offchain/.env (ignored by git). Never commit real keys. Testnets only.

# Your solver: a key funded with a little Unichain Sepolia ETH and Circle test USDC on Unichain Sepolia
# (https://faucet.circle.com). The solver approves the DestinationSettler on start.
SOLVER_PRIVATE_KEY=

# Optional: where you want to be repaid on Base Sepolia (defaults to the solver's own address).
# SOLVER_REPAY_TO=

# Only needed for the bench, refusal cases and demo service (the order-opening wallet).
# USER_PRIVATE_KEY=

# Optional RPC overrides (defaults are public endpoints).
# BASE_SEPOLIA_RPC=https://sepolia.base.org
# UNICHAIN_SEPOLIA_RPC=https://sepolia.unichain.org
